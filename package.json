{
  "name": "ssrf-lab",
  "version": "0.1.0",
  "description": "A local attack range and conformance checker for SSRF and fetch-safety defenses in HTTP clients.",
  "keywords": [
    "ssrf",
    "security",
    "dns-rebinding",
    "zip-bomb",
    "http-client",
    "testing"
  ],
  "license": "MIT",
  "author": "Roshan Amble",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "ssrf-lab": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "scan": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "request-filtering-agent": "3.2.1",
    "ssrf-agent": "1.0.5",
    "ssrf-req-filter": "1.1.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
