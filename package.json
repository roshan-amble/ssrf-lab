{
  "name": "ssrf-lab",
  "version": "0.2.0",
  "description": "Test whether your Node.js fetcher actually blocks SSRF or just got lucky: a local attack range with an independent hit counter, for CI.",
  "keywords": [
    "ssrf",
    "security",
    "dns-rebinding",
    "zip-bomb",
    "http-client",
    "testing",
    "ssrf-protection",
    "security-testing",
    "appsec",
    "webhook",
    "link-preview",
    "github-actions"
  ],
  "license": "MIT",
  "author": "Roshan Amble",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roshan-amble/ssrf-lab.git"
  },
  "homepage": "https://github.com/roshan-amble/ssrf-lab#readme",
  "bugs": {
    "url": "https://github.com/roshan-amble/ssrf-lab/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "ssrf-lab": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "scan": "tsx src/cli.ts",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "guarded-fetch": "0.1.5",
    "request-filtering-agent": "3.2.1",
    "ssrf-agent": "1.0.5",
    "ssrf-req-filter": "1.1.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "guarded-fetch@0.1.5": {
      "undici": "7.30.1"
    }
  }
}
